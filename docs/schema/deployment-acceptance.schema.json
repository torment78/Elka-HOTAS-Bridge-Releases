{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotasbridge.local/schema/deployment-acceptance.schema.json",
  "title": "HOTASBridge Deployment Acceptance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "startedUtc",
    "completedUtc",
    "status",
    "disposableMachineAttested",
    "machine",
    "scope",
    "installRoot",
    "dataRoot",
    "candidate",
    "retained",
    "uninstallChoiceMatrixIncluded",
    "steps",
    "failure"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "startedUtc": { "type": "string", "format": "date-time" },
    "completedUtc": { "type": "string", "format": "date-time" },
    "status": { "enum": ["Passed", "Failed"] },
    "disposableMachineAttested": { "const": true },
    "machine": { "type": "object" },
    "scope": { "enum": ["CurrentUser", "AllUsers"] },
    "installRoot": { "type": "string", "minLength": 1 },
    "dataRoot": { "type": "string", "minLength": 1 },
    "candidate": { "type": "object" },
    "retained": { "type": "object" },
    "uninstallChoiceMatrixIncluded": { "type": "boolean" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "durationSeconds", "detail"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["Passed", "Failed"] },
          "durationSeconds": { "type": "number", "minimum": 0 },
          "detail": { "type": "array" }
        }
      }
    },
    "failure": { "type": ["object", "null"] }
  }
}
