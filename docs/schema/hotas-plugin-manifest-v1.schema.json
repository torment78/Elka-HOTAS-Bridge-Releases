{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotasbridge.local/schema/hotas-plugin-manifest-v1.schema.json",
  "title": "HOTASBridge Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "description",
    "supportedApiVersion",
    "categories"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "supportedApiVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximumExclusive"],
      "properties": {
        "minimum": { "type": "string" },
        "maximumExclusive": { "type": "string" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "output",
          "inputProvider",
          "transform",
          "diagnostics",
          "importer",
          "exporter",
          "profileTool",
          "uiExtension"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pluginId", "minimumVersion"],
        "properties": {
          "pluginId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "minimumVersion": { "type": "string" },
          "maximumVersionExclusive": { "type": ["string", "null"] },
          "optional": { "type": "boolean", "default": false }
        }
      }
    },
    "entryAssembly": { "type": ["string", "null"] },
    "entryType": { "type": ["string", "null"] },
    "releaseNotes": { "type": ["string", "null"] },
    "projectUrl": { "type": ["string", "null"], "format": "uri" },
    "signature": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["algorithm", "signer", "digest"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "signer": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 }
      }
    }
  }
}
