{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hotasbridge.local/schema/hotas-profile-v3.schema.json",
  "title": "HOTASBridge Profile Schema v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "applicationVersion",
    "profileVersion",
    "profileId",
    "name",
    "createdUtc",
    "lastModifiedUtc",
    "deviceGroups",
    "selectedDevices",
    "mappings",
    "outputs",
    "outputConflictMode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "applicationVersion": {
      "type": "string"
    },
    "profileVersion": {
      "type": "integer",
      "minimum": 0
    },
    "profileId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "createdUtc": {
      "type": "string",
      "format": "date-time"
    },
    "lastModifiedUtc": {
      "type": "string",
      "format": "date-time"
    },
    "targetApplication": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "lastMigratedFromSchemaVersion": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "lastMigrationUtc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "inputSourceMode": {
      "type": "string"
    },
    "deviceGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deviceGroup"
      }
    },
    "selectedDevices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selectedDevice"
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "axisCurves": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "shiftLayers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "outputTarget": {
      "type": "string"
    },
    "outputConflictMode": {
      "type": "string",
      "enum": [
        "firstWins",
        "lastWins",
        "highestPriority"
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "deviceGroup": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "selectedDevice": {
      "type": "object",
      "required": [
        "stableDeviceId",
        "displayName",
        "deviceGroupId",
        "isEnabled"
      ],
      "properties": {
        "stableDeviceId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "internalDeviceGuid": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "containerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "serialNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "devicePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "vendorId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "productId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "usagePage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "usageId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "deviceGroupId": {
          "type": "string",
          "minLength": 1
        },
        "sourceKind": {
          "type": "string"
        },
        "isEnabled": {
          "type": "boolean"
        },
        "isConnected": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "mapping": {
      "type": "object",
      "required": [
        "mappingId",
        "deviceStableId",
        "inputControlId",
        "inputType",
        "outputPluginId",
        "outputControl",
        "transformChain",
        "isEnabled",
        "name",
        "outputControlId",
        "outputKind",
        "outputConfiguration",
        "conditions",
        "priority",
        "notes"
      ],
      "properties": {
        "mappingId": {
          "type": "string",
          "format": "uuid"
        },
        "deviceStableId": {
          "type": "string",
          "minLength": 1
        },
        "deviceDisplayName": {
          "type": "string"
        },
        "inputControlId": {
          "type": "string",
          "minLength": 1
        },
        "inputDisplayName": {
          "type": "string"
        },
        "inputType": {
          "type": "string"
        },
        "outputPluginId": {
          "type": "string",
          "minLength": 1
        },
        "outputControl": {
          "type": "string"
        },
        "transformChain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transform"
          }
        },
        "behavior": {
          "type": "string"
        },
        "isEnabled": {
          "type": "boolean"
        },
        "shiftLayerId": {
          "type": "string"
        },
        "axisProcessing": {
          "type": "object"
        },
        "buttonProcessing": {
          "type": "object"
        },
        "pulseDuration": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "outputControlId": {
          "type": "string",
          "minLength": 1
        },
        "outputKind": {
          "type": "string",
          "enum": [
            "auto",
            "axis",
            "button",
            "keyboard",
            "pwmKeyboard"
          ]
        },
        "outputConfiguration": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "priority": {
          "type": "integer"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "transform": {
      "type": "object",
      "required": [
        "id",
        "type",
        "isEnabled",
        "settings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "isEnabled": {
          "type": "boolean"
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": [
        "pluginId",
        "displayName",
        "isEnabled",
        "settings"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "isEnabled": {
          "type": "boolean"
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "condition": {
      "type": "object",
      "required": [
        "id",
        "type",
        "operand",
        "expectedState"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "profileActive",
            "layerActive",
            "shiftControlHeld",
            "deviceConnected",
            "toggleEnabled"
          ]
        },
        "operand": {
          "type": "string",
          "minLength": 1
        },
        "expectedState": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
